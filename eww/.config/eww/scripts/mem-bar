#!/bin/bash

# Braille characters from empty to full
braille_chars=("⠀" "⠁" "⠃" "⠇" "⡇" "⣇" "⣧" "⣷" "⣿")

# Draw an 8-block braille bar based on % usage
draw_braille_bar() {
    usage=$1
    bar_width=8
    filled=$(( usage * bar_width / 100 ))
    
    if [ "$filled" -gt "$bar_width" ]; then
        filled=$bar_width
    fi

    bar=""
    for ((i=0; i<bar_width; i++)); do
        if (( i < filled )); then
            bar+="${braille_chars[8]}"
        else
            bar+="${braille_chars[0]}"
        fi
    done
    echo "[ $bar ]"
}

# Get memory usage using ps & awk (more responsive than /proc/meminfo)
get_ram_usage() {
    # Get memory usage percentage from all processes
    local total_used=$(ps aux --sort=-%mem | awk '
    NR>1 {
        # Extract RSS in KB from column 6, convert to MB
        if ($6 ~ /^[0-9]+$/) {
            total += $6
        }
    }
    END {
        print int(total / 1024)  # Convert to MB
    }')
    
    # Get total memory in MB
    local total_mem=$(grep MemTotal /proc/meminfo | awk '{print int($2/1024)}')
    
    if [ "$total_mem" -gt 0 ]; then
        echo $(( (total_used * 100) / total_mem ))
    else
        echo 0
    fi
}

get_swap_usage() {
    # Use /proc/meminfo for swap (it's less critical for responsiveness)
    awk '
    /^SwapTotal:/ { total = $2 }
    /^SwapFree:/ { free = $2 }
    END {
        if (total > 0) {
            used = total - free
            usage = (used * 100) / total
            printf "%d\n", usage
        } else {
            print 0
        }
    }
    ' /proc/meminfo
}

# CLI arg parser
case "$1" in
    ram)
        ram=$(get_ram_usage)
        draw_braille_bar "$ram"
        ;;
    swap)
        swap=$(get_swap_usage)
        draw_braille_bar "$swap"
        ;;
    *)
        echo "Usage: $0 {ram|swap}"
        exit 1
        ;;
esac

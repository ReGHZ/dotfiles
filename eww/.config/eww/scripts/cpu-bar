#!/bin/bash

# Check if a core number was provided
if [ -z "$1" ]; then
    echo "Usage: $0 <core_number>"
    exit 1
fi

core_target="$1"
STATE_DIR="/tmp/eww-cpu-state"
mkdir -p "$STATE_DIR"

# Braille characters from left (empty) to right (full)
braille_chars=("⠀" "⠁" "⠃" "⠇" "⡇" "⣇" "⣧" "⣷" "⣿")

# Get per-core CPU usage from /proc/stat
get_cpu_usage() {
    local core=$1
    local state_file="$STATE_DIR/cpu-$core.state"
    
    # Read current CPU stats
    local cpu_line=$(sed -n "$(( core + 2 ))p" /proc/stat 2>/dev/null)
    
    if [ -z "$cpu_line" ]; then
        echo 0
        return
    fi
    
    read -a current_sample <<< "$cpu_line"
    local user2=${current_sample[1]:-0}
    local nice2=${current_sample[2]:-0}
    local system2=${current_sample[3]:-0}
    local idle2=${current_sample[4]:-0}
    
    # Read previous state if exists
    if [ -f "$state_file" ]; then
        read user1 nice1 system1 idle1 < "$state_file"
    else
        user1=$user2
        nice1=$nice2
        system1=$system2
        idle1=$idle2
    fi
    
    # Save current state for next run
    echo "$user2 $nice2 $system2 $idle2" > "$state_file"
    
    # Calculate deltas
    local user_delta=$(( user2 - user1 ))
    local nice_delta=$(( nice2 - nice1 ))
    local system_delta=$(( system2 - system1 ))
    local idle_delta=$(( idle2 - idle1 ))
    
    local total_delta=$(( user_delta + nice_delta + system_delta + idle_delta ))
    
    if [ "$total_delta" -eq 0 ]; then
        echo 0
        return
    fi
    
    local usage=$(( (user_delta + nice_delta + system_delta) * 100 / total_delta ))
    echo "$usage"
}

usage=$(get_cpu_usage "$core_target")
usage_int=$(( usage ))
bar_width=8
fill_level=$(( usage_int * bar_width / 100 ))

if [ "$fill_level" -gt "$bar_width" ]; then
    fill_level=$bar_width
fi

bar=""
for ((i=0; i<bar_width; i++)); do
    if (( i < fill_level )); then
        bar+="${braille_chars[8]}"
    else
        bar+="${braille_chars[0]}"
    fi
done

echo "[ $bar ]"

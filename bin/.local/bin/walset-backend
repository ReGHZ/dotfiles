#!/bin/bash

set -e

# Check dependencies
for cmd in swww wal matugen notify-send magick; do
    if ! command -v "$cmd" &>/dev/null; then
        echo "Error: '$cmd' is not installed or not in PATH."
        exit 2
    fi
done

# Check if the user provided an argument
if [ "$#" -ne 1 ]; then
    echo "Usage: $0 <path_to_image>"
    exit 1
fi

IMAGE="$1"

if [ ! -f "$IMAGE" ]; then
    echo "Error: File '$IMAGE' does not exist."
    exit 3
fi

# Send notification to the user
notify-send "Changing Theme" "Applying new wallpaper and updating colors, please wait until confirmation..."

# Set wallpaper
# swww img "$IMAGE" --transition-type="center" --transition-step=1 --transition-fps="60"
for MON in $(hyprctl monitors -j | jq -r '.[].name'); do
    swww img "$IMAGE" --outputs "$MON" --transition-type="center" --transition-step=1 --transition-fps="60"
done

# Generate pywal colors
is_grayscale() {
  python - "$1" <<'PY'
import re
import subprocess
import sys

img = sys.argv[1]
cmd = [
    "magick",
    img,
    "-alpha",
    "off",
    "-resize",
    "64x64",
    "-colors",
    "16",
    "-unique-colors",
    "txt:-",
]

try:
    output = subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL)
except Exception:
    sys.exit(1)

hexes = re.findall(r"#([0-9A-Fa-f]{6})", output)
for h in hexes:
    r = int(h[0:2], 16)
    g = int(h[2:4], 16)
    b = int(h[4:6], 16)
    if r != g or g != b:
        sys.exit(1)

sys.exit(0)
PY
}

gray_mean() {
  python - "$1" <<'PY'
import subprocess
import sys

img = sys.argv[1]
cmd = [
    "magick",
    img,
    "-colorspace",
    "Gray",
    "-format",
    "%[fx:round(255*mean)]",
    "info:",
]

try:
    output = subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL).strip()
    v = int(output)
except Exception:
    v = 128

v = max(0, min(255, v))
print(f"#{v:02x}{v:02x}{v:02x}")
PY
}

make_bw_theme() {
  local img="$1"
  local out="$2"
  python - "$img" "$out" <<'PY'
import json
import re
import subprocess
import sys

img, out = sys.argv[1], sys.argv[2]
cmd = [
    "magick",
    img,
    "-colorspace",
    "Gray",
    "-format",
    "%[fx:round(255*minima.r)],%[fx:round(255*maxima.r)]",
    "info:",
]

try:
    output = subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL).strip()
    parts = [int(p) for p in output.split(",")]
    lo, hi = parts[0], parts[1]
except Exception:
    lo, hi = 0, 255

lo = max(0, min(255, lo))
hi = max(0, min(255, hi))
if lo == hi:
    hi = 255 if lo < 255 else 0

def gray_hex(v):
    return f"#{v:02x}{v:02x}{v:02x}"

def blend_gray(a, b, t):
    return round(a + (b - a) * t)

colors = [gray_hex(blend_gray(lo, hi, i / 15.0)) for i in range(16)]
data = {
    "special": {"background": colors[0], "foreground": colors[-1], "cursor": colors[-1]},
    "colors": {f"color{i}": colors[i] for i in range(16)},
}

with open(out, "w", encoding="utf-8") as f:
    json.dump(data, f, separators=(",", ":"))
PY
}

if is_grayscale "$IMAGE"; then
  TMP_WAL_THEME="$(mktemp /tmp/wal-bw-XXXXXX.json)"
  make_bw_theme "$IMAGE" "$TMP_WAL_THEME"
  wal --theme "$TMP_WAL_THEME" -n -s -t -e
elif ! wal -i "$IMAGE" -n -s -t -e; then
  TMP_WAL_THEME="$(mktemp /tmp/wal-bw-XXXXXX.json)"
  make_bw_theme "$IMAGE" "$TMP_WAL_THEME"
  wal --theme "$TMP_WAL_THEME" -n -s -t -e
fi

# Use Matugen to generate Material You colors
MATUGEN_ARGS=()
if is_grayscale "$IMAGE"; then
  MATUGEN_ARGS=(--type scheme-monochrome --fallback-color "$(gray_mean "$IMAGE")")
fi
matugen image "$IMAGE" "${MATUGEN_ARGS[@]}"

# Hyprlock change colors
M_CONF="$HOME/.config/hypr/colors.conf"
get_rgba() {
  local NAME="$1"
  grep "^\$$NAME" "$M_CONF" | head -n1 | cut -d'=' -f2 | tr -d ' '
}

BG_RGBA=$(get_rgba background)
FG_RGBA=$(get_rgba primary)

# change background alpha to 0.5 ("80" = 0,5 in 8 digit hex) 
BG_RGBA_SEMI=$(echo "$BG_RGBA" \
  | sed -E 's/rgba\(\s*([0-9A-Fa-f]{6})([0-9A-Fa-f]{2})?\s*\)/rgba(\1'"80"')/')

# --- Generate hyprlock.conf every change theme ---
HYPRLOCK="$HOME/.config/hypr/hyprlock.conf"
cat > "$HYPRLOCK" <<-EOF
general {
    hide_cursor = false
}

background {
    monitor =
    color = $BG_RGBA
    blur_passes = 0
    blur_size = 7
    noise = 0.0117
    brightness = 0.7
}

input-field {
    monitor =
    font_family = JetBrainsMono Nerd Font
    size = 200, 50
    outline_thickness = 0
    outer_color = rgba(0, 0, 0, 0)
    inner_color = rgba(17, 17, 17, 0.6)
    dots_size = 0.2
    dots_spacing = 0.5
    dots_center = true
    dots_rounding = 0
    font_color = $FG_RGBA
    fade_on_empty = true
    hide_input = false
    position = 0, -240
    halign = center
    valign = center
    placeholder_text = PASSWORD
    fail_text = ACCESS_DENIED
    fail_color = rgba(0, 0, 0, 0)    
    check_color = rgba(0, 0, 0, 0)        
    swap_font_color = false  
    rounding = 0
}

label {
    monitor =
    text = cmd[update:1000] date +"<b><span size='60pt'>[ %I.%M </span> <span size='25pt'> %p</span><span size='60pt'> ]</span></b>"
    font_size = 25
    font_family = JetBrainsMono Nerd Font
    color = $FG_RGBA
    position = 0, 0
    halign = center
    valign = center
}
EOF

# Refresh swaync
pkill swaync
swaync > /dev/null 2>&1 &

# Refresh waybar
pkill waybar
pkill -f "mediaplayer.py" 2>/dev/null
waybar > /dev/null 2>&1 &

# Notify swaync
notify-send "Theme Applied" "Wallpaper and theme updated successfully!"
